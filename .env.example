# Copy to .env and adjust. All keys are optional; defaults live in
# sidecar/app/config.py.

# --- device -------------------------------------------------------------
# "cuda" (spec default, requires a CUDA-capable GPU) or "cpu".
# This is the ONLY device switch in the codebase. See docs/cpu-fallback-plan.md.
FS_ML_DEVICE=cuda

# Keep at most one large model in memory at a time, evicting the others on
# load. Needed when models live in system RAM rather than VRAM: bge (1.3GB) +
# OpenCLIP ViT-H/14 (2.9GB) + moondream2 (4.1GB) is ~8.3GB. Costs a reload
# when the pipeline moves between stages. Leave off on a GPU.
FS_ML_LOW_MEMORY=false

# --- process ------------------------------------------------------------
FS_PORT=8756
FS_LOG_LEVEL=INFO

# --- storage ------------------------------------------------------------
# Defaults to %LOCALAPPDATA%\FileSearch. Keep this OFF a synced folder
# (OneDrive/Dropbox): it holds the SQLite file, Qdrant storage and ~10GB of
# model weights.
# FS_DATA_DIR=C:\Users\you\AppData\Local\FileSearch

# --- OCR ----------------------------------------------------------------
# "paddleocr" (spec default, GPU) or "tesseract" (CPU fallback).
FS_OCR_ENGINE=paddleocr
# FS_TESSERACT_EXE=C:\Program Files\Tesseract-OCR\tesseract.exe

# Image understanding: captions + CLIP image vectors. OCR is separate and
# always runs. Turn this off on a CPU-only machine, where captioning one image
# costs several minutes; turn it on with a GPU.
FS_ENABLE_IMAGE_UNDERSTANDING=true

# --- captioning ---------------------------------------------------------
# "moondream2" (default) or "blip2".
FS_CAPTIONER=moondream2
